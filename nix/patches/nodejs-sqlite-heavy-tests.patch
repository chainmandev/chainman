 test/parallel/test-sqlite-statement.js        | 55 +----------------
 test/pummel/test-sqlite-statement-too-long.js | 60 +++++++++++++++++++
 2 files changed, 61 insertions(+), 54 deletions(-)
 create mode 100644 test/pummel/test-sqlite-statement-too-long.js

