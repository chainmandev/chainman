set positional-arguments
set shell := ["sh", "-eu", "-c"]

default:
    @just --list

setup:
    @./scripts/chainman.sh setup

exec +args:
    @./scripts/chainman.sh exec -- "$@"

exec-in profile +args:
    @profile=$1; shift; ./scripts/chainman.sh exec --profile "$profile" -- "$@"

shell profile="core":
    @./scripts/chainman.sh shell --profile "$1"

build:
    @./scripts/chainman.sh build

test:
    @./scripts/chainman.sh test

verify:
    @./scripts/chainman.sh verify

format:
    @./scripts/chainman.sh format

format-check:
    @./scripts/chainman.sh run format-check

module name action="verify":
    @./scripts/chainman.sh module "$@"

deps-update *args:
    @./scripts/chainman.sh deps-update "$@"

cache-status:
    @./scripts/chainman.sh cache-status

cache-prune *args:
    @./scripts/chainman.sh cache-prune "$@"

clean:
    @./scripts/chainman.sh clean

doctor:
    @./scripts/chainman.sh doctor

ci-prune *args:
    @./scripts/chainman.sh ci-prune "$@"

sdk-doctor platform:
    @./scripts/chainman.sh sdk-doctor "$1"
