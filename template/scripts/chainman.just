    set -eu
    exec ./scripts/chainman.sh chainman-update "$@"

[group("Chainman")]
[positional-arguments]
clean *args:
    #!/bin/sh
    set -eu
    ./scripts/chainman.sh services-stop
    exec ./scripts/chainman.sh clean "$@"

[group("Chainman")]
[positional-arguments]
config *args:
