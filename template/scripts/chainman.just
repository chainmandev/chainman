# Generated by the pinned Chainman runtime. Configure recipes in chainman.toml.

[group("Chainman")]
[positional-arguments]
cache-prune *args:
    #!/bin/sh
    set -eu
    exec ./scripts/chainman.sh cache-prune "$@"

[group("Chainman")]
[positional-arguments]
cache-status *args:
    #!/bin/sh
    set -eu
    exec ./scripts/chainman.sh cache-status "$@"

