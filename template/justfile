# Project-owned forwarding recipes are optional; Chainman never rewrites them.
[positional-arguments]
verify *args:
    #!/bin/sh
    exec {{quote(just_executable())}} chainman recipe verify "$@"

# Install all declared setup groups and the Git hooks.
[positional-arguments]
setup *args:
    #!/bin/sh
    exec {{quote(just_executable())}} chainman setup "$@"

format-staged:
    @{{quote(just_executable())}} chainman format-staged

[positional-arguments]
hooks +args:
    #!/bin/sh
    exec {{quote(just_executable())}} chainman hooks "$@"
